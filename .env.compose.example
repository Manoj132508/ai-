# Copy to .env (in this directory) for `docker compose up`. NEVER commit the
# real .env. Compose reads this file automatically for ${VAR} interpolation in
# docker-compose.yml.

# --- required secrets -------------------------------------------------------
# Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-generated-secret

# Shared secret the server sends to the AI service (X-Internal-Key). Any long
# random string; the two services just have to agree.
INTERNAL_API_KEY=replace-me-with-a-long-random-string

# --- generation provider ----------------------------------------------------
# 'ollama' (default, free, local) or 'anthropic' (hosted, paid).
LLM_PROVIDER=ollama
# Ollama runs on the host by default; the container reaches it here.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
# Only needed if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- optional ---------------------------------------------------------------
# production => secure cookies (needs HTTPS in front). For a quick local http
# trial at http://localhost:8080, set this to development so the auth cookie is
# not marked Secure. See DEPLOYMENT.md.
NODE_ENV=production
# Host port the SPA is published on.
CLIENT_PORT=8080
# Only needed if the SPA is served from a different origin than the API.
CORS_ORIGINS=http://localhost:8080
