# Copy to .env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4200

# Comma-separated list of browser origins allowed to call this API.
# In development the Vite dev server proxies /api, so requests are
# same-origin and CORS is not exercised. It matters in production, where the
# SPA is served from CloudFront and the API from a different origin.
CORS_ORIGINS=http://localhost:5177

# The Python AI service. Bound to localhost: it must never be publicly
# reachable, because it performs no authorisation of its own (ADR 001).
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret sent as X-Internal-Key on every call to the AI service.
# Required in production; a development default is used when unset.
INTERNAL_API_KEY=dev-internal-key-change-me

# MongoDB. Required in production -- there is no fallback, because an Atlas
# URI contains credentials and must never have a default in source.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_knowledge_assistant

# Session signing secret. REQUIRED IN EVERY ENVIRONMENT -- there is no default,
# because a development fallback is how a publicly-known secret reaches
# production and lets anyone mint a session for any account.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-generated-secret

# Session lifetime. Short on purpose: a JWT cannot be revoked, so this is the
# only bound on how long a stolen token stays useful.
JWT_EXPIRES_IN=2h

# Uploaded documents. Local disk in development; S3 from phase 14.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Rate limiting (phase 11, ADR 012). All optional -- the defaults below apply
# when unset. Windows are in milliseconds. Tighten in production as needed.
#   global: loose backstop against one IP flooding the API
#   auth:   tight, guards login/register against brute force + enumeration
#   ask:    per-minute, caps the expensive LLM ask endpoint
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_ASK_WINDOW_MS=60000
# RATE_LIMIT_ASK_MAX=15
