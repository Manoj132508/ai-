# Copy to .env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4200

# Comma-separated list of browser origins allowed to call this API.
# In development the Vite dev server proxies /api, so requests are
# same-origin and CORS is not exercised. It matters in production, where the
# SPA is served from CloudFront and the API from a different origin.
CORS_ORIGINS=http://localhost:5177

# The Python AI service. Bound to localhost: it must never be publicly
# reachable, because it performs no authorisation of its own (ADR 001).
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret sent as X-Internal-Key on every call to the AI service.
# Required in production; a development default is used when unset.
INTERNAL_API_KEY=dev-internal-key-change-me

# MongoDB. Required in production -- there is no fallback, because an Atlas
# URI contains credentials and must never have a default in source.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_knowledge_assistant
