{
  "name": "ai-knowledge-assistant-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Express API: authentication, tenancy, file storage and orchestration of the Python AI service.",
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node --env-file=.env server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "indexes": "node --env-file=.env scripts/indexes.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  }
}
