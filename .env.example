# Copy to .env for local development and replace the placeholders.
# .env is gitignored; the real key must never be committed.

# Anthropic API key, used ONLY by the generation step. Chunking, embedding,
# retrieval and the vector store are entirely local and need no key.
# The SDK reads this variable name automatically, so a zero-argument
# Anthropic() client picks it up with no plumbing.
ANTHROPIC_API_KEY=your_key_here

# Model used to generate grounded answers.
LLM_MODEL=claude-opus-5

# Effort controls how much the model deliberates. Grounded question answering
# over retrieved text is not a heavy reasoning task, so "medium" trades a
# little depth for noticeably lower latency on a streamed answer. Sweep this
# against your own questions before settling -- "high" is the API default.
LLM_EFFORT=medium

# Shared secret. Must match INTERNAL_API_KEY in server/.env: the Node API
# sends it as X-Internal-Key on every call, and this service rejects requests
# without it.
INTERNAL_API_KEY=dev-internal-key-change-me

# Where the Node API lives, for the indexing callback.
NODE_API_URL=http://127.0.0.1:4200

# Local embedding model and vector store.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_data

# Chunking. 800 characters is roughly 200 tokens, which sits safely under
# MiniLM's 256-token ceiling -- longer input is silently TRUNCATED, not
# rejected, so this bound is a correctness constraint rather than tuning.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval. Nothing below the threshold is answered: cosine similarity always
# returns a nearest neighbour, so without this the model would confidently
# answer questions the documents cannot address (ADR 008).
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
