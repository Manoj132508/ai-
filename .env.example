# Copy to .env for local development and replace the placeholders.
# .env is gitignored; a real API key must never be committed.

# ---------------------------------------------------------------------------
# Generation provider
# ---------------------------------------------------------------------------
# 'ollama'    -> free local model, NO API key required (the default).
# 'anthropic' -> hosted, paid model; requires ANTHROPIC_API_KEY below.
# Any other value fails at startup. There is no silent fallback between them.
LLM_PROVIDER=ollama

# Max answer length, shared by both providers (Anthropic max_tokens / Ollama
# num_predict).
LLM_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Ollama (local, default) -- https://ollama.com
# ---------------------------------------------------------------------------
# Install Ollama, start it, then: `ollama pull llama3.2:3b`
# llama3.2:3b is ~2 GB and runs comfortably on a CPU-only laptop.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---------------------------------------------------------------------------
# Anthropic (hosted, optional, PAID) -- only used when LLM_PROVIDER=anthropic
# ---------------------------------------------------------------------------
# Chunking, embedding, retrieval and the vector store are entirely local and
# never touch this key. The SDK reads ANTHROPIC_API_KEY automatically, so a
# zero-argument client picks it up with no plumbing. Leave it empty for the
# default (ollama) provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Effort controls how much the Anthropic model deliberates (ignored by Ollama).
# "medium" trades a little depth for lower latency on a streamed answer.
LLM_EFFORT=medium

# ---------------------------------------------------------------------------
# Internal wiring
# ---------------------------------------------------------------------------
# Shared secret. Must match INTERNAL_API_KEY in server/.env: the Node API sends
# it as X-Internal-Key on every call, and this service rejects requests without
# it.
INTERNAL_API_KEY=dev-internal-key-change-me

# Where the Node API lives, for the indexing callback.
NODE_API_URL=http://127.0.0.1:4200

# Local embedding model and vector store.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_data

# Chunking. 800 characters is roughly 200 tokens, which sits safely under
# MiniLM's 256-token ceiling -- longer input is silently TRUNCATED, not
# rejected, so this bound is a correctness constraint rather than tuning.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval. Nothing below the threshold is answered: cosine similarity always
# returns a nearest neighbour, so without this the model would confidently
# answer questions the documents cannot address (ADR 008).
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
